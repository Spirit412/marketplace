# =============================================================================
# Marketplace Frontend — шаблон .env для локальной разработки
# =============================================================================
# Скопируйте в .env.local:
#   cp .env.example .env.local
#
# Для Docker (docker compose up) — используйте .env с именами сервисов.
# =============================================================================

VITE_APP_MODE=DEV
VITE_API_URL=http://localhost:8100
VITE_AUTH_URL=http://localhost:8110
VITE_CATALOG_URL=http://localhost:8120
VITE_ORDER_URL=http://localhost:8130
VITE_PAYMENT_URL=http://localhost:8140
VITE_NOTIFICATION_URL=http://localhost:8150
VITE_SCHEDULER_URL=http://localhost:8160
VITE_REPORT_URL=http://localhost:8170
VITE_INVENTORY_URL=http://localhost:8180
VITE_DICTIONARY_URL=http://localhost:8190
VITE_IMPORT_URL=http://localhost:8101
VITE_WS_URL=ws://localhost:8150/ws

VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false
