# api-service

# Application
APP_NAME=api-service
APP_ID=API
APP_PORT=8100
LOG_LEVEL=debug

# Redis (check-access cache for AuthMiddleware only — no domain data)
REDIS_HOST=mp-redis
REDIS_PORT=6379
REDIS_DB=0

# Auth
AUTH_SERVICE_URL=http://mp-auth-service:8110

# Downstream services this BFF composes responses from
CATALOG_SERVICE_URL=http://mp-catalog-service:8120
ORDER_SERVICE_URL=http://mp-order-service:8130
PAYMENT_SERVICE_URL=http://mp-payment-service:8140
INVENTORY_SERVICE_URL=http://mp-inventory-service:8180
