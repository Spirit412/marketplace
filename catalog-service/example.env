# catalog-service Environment — example
# Copy to .env and fill in real values.

# Application
APP_NAME=catalog-service
APP_PORT=8120
LOG_LEVEL=debug
LOG_FORMAT=text

# PostgreSQL
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=catalog_service_db

# PostgreSQL Pool
POSTGRES_POOL_PRE_PING=true
POSTGRES_ECHO=false
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_RECYCLE=3600
POSTGRES_AUTO_COMMIT=false
POSTGRES_AUTO_FLUSH=false
POSTGRES_EXPIRE_ON_COMMIT=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# RabbitMQ
RABBITMQ_USER=marketplace
RABBITMQ_PASSWORD=marketplace
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Cache
CACHE_TTL=300
